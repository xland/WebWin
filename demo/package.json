{
  "name": "webwin-demo",
  "version": "1.0.0",
  "private": true,
  "secondInstanceNotify": true,
  "webwin": {
    "id": "webwin.demo",
    "name": "WebWin 演示应用",
    "version": [
      1,
      0,
      0
    ],
    "quitWhenNoWindow": true,
    "window": {
      "title": "WebWin API 演示",
      "size": "maximize",
      "miniSize": {
        "w": 400,
        "h": 300
      },
      "pos": "centerScreen",
      "frame": true,
      "webview": {
        "path": "index.html",
        "allowWindowOpen": true,
        "allowRemoteSdk": false
      }
    }
  }
}
