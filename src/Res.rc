#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS
100 ICON "res/logo.ico"

// 随 exe 内嵌的 web 资源：src/web 下的产物（js 注入到页面，html 作为内置默认页面）。
// 改了 src/web 下的源码后，需先在该目录执行 npm run build:all 重新生成 dist
"webwin.js" RCDATA "web/dist/webwin.js"
"default.html" RCDATA "web/dist/default.html"


VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 0, 1, 0
PRODUCTVERSION 0, 0, 1, 0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
	FILEFLAGS 0x1L
#else
	FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "080404b0"
		BEGIN
			VALUE "CompanyName", "GitHub xland"
			VALUE "FileDescription", "WebWin"
			VALUE "FileVersion", "0.0.1.0"
			VALUE "InternalName", "WebWin.exe"
			VALUE "LegalCopyright", "Copyright (C) LiuXiaolun 2026"
			VALUE "OriginalFilename", "WebWin.exe"
			VALUE "ProductName", "WebWin"
			VALUE "ProductVersion", "0.0.1.0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x804, 1200
	END
END